# ==============================================================================
# GD Arena Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Do NOT commit `.env` or `.env.local` to version control.

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider Configuration
# Fast, low-latency models for real-time turn streaming (e.g. Groq, Google Gemini)
# ------------------------------------------------------------------------------
# Provider options: "groq" | "gemini" | "openai"
LLM_PRIMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Fallback LLM Provider Configuration
# Used when primary provider experiences timeout (>4s) or rate limiting
# ------------------------------------------------------------------------------
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI Provider (if using openai as primary or fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Report & Feedback Generation Configuration
# Used for post-session rubric scoring, stats validation, and evidence checks
# ------------------------------------------------------------------------------
REPORT_LLM_PROVIDER=gemini
REPORT_LLM_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 4. Optional Cloud TTS Provider (Tier B - Quality Upgrade)
# By default, GD Arena uses browser SpeechSynthesis (Tier A, zero cost, 0ms latency).
# Set TTS_PROVIDER to "elevenlabs" or "cartesia" if cloud voices are enabled.
# ------------------------------------------------------------------------------
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# ------------------------------------------------------------------------------
# 5. Security, Rate Limiting & Session Bounds
# ------------------------------------------------------------------------------
# Max requests per minute per IP address on /api/turn and /api/report
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Server-side safety caps
MAX_SESSION_DURATION_SECONDS=600
MAX_TURN_TOKENS=100
MAX_REPORT_TOKENS=3000

# ------------------------------------------------------------------------------
# 6. Application Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
